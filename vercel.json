{
  "functions": {
    "api/[...path].js": {
      "includeFiles": "data/products.json"
    },
    "api/admin/[...path].js": {
      "includeFiles": "data/products.json"
    },
    "api/admin/orders/[id].js": {
      "includeFiles": "data/products.json"
    },
    "api/admin/orders/[id]/status.js": {
      "includeFiles": "data/products.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/products/:id",
      "destination": "/api/admin-resource?resource=products&id=:id"
    },
    {
      "source": "/api/admin/users/:id",
      "destination": "/api/admin-resource?resource=users&id=:id"
    },
    {
      "source": "/api/admin/uploads/:id",
      "destination": "/api/admin-resource?resource=uploads&id=:id"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/uploads/:path*"
    }
  ]
}
